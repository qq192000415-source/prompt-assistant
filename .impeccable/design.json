  "narrative": {
    "northStar": "整洁的卡片柜 (The Tidy Card Cabinet)",
    "overview": "每一条提示词、每一个文档、每一张素材都像归好位的卡片：放在哪里一眼可见，取用只要一步。界面是安静的浅色工作台，只在需要动作的地方出现一抹蓝。所有装饰都服从「找到即复制」。",
    "keyCharacteristics": ["浅灰底面（surface-quiet）上放白色卡片，描边 1px。", "单一蓝色强调，只用于主按钮、选中状态和分类徽标。", "青绿色专门表示「全局搜索」，不挪作他用。", "中文界面，系统字体 Segoe UI Variable 和微软雅黑。"],
    "rules": [
      { "name": "一处蓝 The One Blue Rule", "body": "同一屏里蓝色只标出「下一步该点哪里」和「当前选中的是什么」，其余一律中性色。", "section": "colors" },
      { "name": "青绿专用 The Teal Is Global Rule", "body": "青绿色只表示全局搜索，别的状态不能借用。", "section": "colors" },
      { "name": "静止即平面 The Flat At Rest Rule", "body": "卡片静止时只有描边，悬停或打开时才出现阴影。", "section": "elevation" }
    ],
    "dos": ["Do 让最常用的动作（复制）在卡片上一步可达。", "Do 选中状态用工作蓝描边加 accent-weak 背景或光环来表示。", "Do 暗色模式下使用令牌，不要写死颜色。"],
    "donts": ["Don't 把青绿色用在全局搜索以外的地方。", "Don't 给静止的卡片加阴影，或用渐变铺背景。", "Don't 用 faint 色写需要阅读的文字。"]
  }
