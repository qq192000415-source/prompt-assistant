# 复制为 .env 后填写。不要把 .env 提交到 Git。

# Supabase 云同步。两项都留空时，软件只使用本机数据。
VITE_SUPABASE_URL=https://你的项目.supabase.co
VITE_SUPABASE_ANON_KEY=你的_publishable_or_anon_key

# 可选，多个邮箱用英文逗号分隔。
# 填写后，只有这些登录账号能在软件里修改云端配置。
# 留空时，本机可以直接修改云端配置。对外分发安装包前建议填你自己的邮箱。
VITE_ADMIN_EMAILS=

# 可选，网页版地址。填写后桌面版「设置 > 关于与更新」显示网页版入口（复制链接、在浏览器打开）。
VITE_WEB_URL=

# 安装版自动更新地址。指向你自己的 HTTPS 目录，里面放 latest.yml、安装包和 blockmap。
# 留空则安装版不检查更新。
UPDATE_BASE_URL=https://你的域名/prompt-assistant-updates/win

# 只有执行 npm run publish:update 时才需要。
UPDATE_SERVER_HOST=你的服务器主机名或IP
UPDATE_SERVER_USER=你的SSH用户
UPDATE_SERVER_SSH_KEY=你的SSH私钥绝对路径
UPDATE_SERVER_REMOTE_DIR=/opt/prompt-assistant-updates/win

# 可选：安装包另传一份到这个公开 GitHub 仓库的 Releases（需要先 gh auth login），更新清单里写上经国内镜像的下载地址。
# 留空就只用上面的更新服务器。格式：用户名/仓库名
UPDATE_GITHUB_REPO=

# 仅离线迁移旧数据时使用。不要放进客户端，不要提交真实值。
# SUPABASE_SERVICE_ROLE_KEY=你的_service_role_key

# 只有执行 npm run web:publish 时才需要：网页版文件经 WebDAV 传到 NAS 上 Caddy 读的目录（见 deploy/web-nas/）。
# 用只对这个文件夹有读写权限的专用账号。
WEB_DEPLOY_DAV_URL=https://你的NAS地址:端口/团队文件-网页版文件夹
WEB_DEPLOY_DAV_USER=
WEB_DEPLOY_DAV_PASSWORD=
